<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Biblioteca de jogos" Width="740" Height="550" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#0D1114" Foreground="#EDF2F0" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Background="#0D1114" Padding="24">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,17">
            <Border Width="43" Height="43" CornerRadius="10" Background="#2C4235" Margin="0,0,11,0">
                <TextBlock Text="&#xE7FC;" Style="{DynamicResource Glyph}" Foreground="#BAF48B" FontSize="21"/>
            </Border>
            <TextBlock Text="Biblioteca de jogos" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,13">
            <Label Content="_Buscar por nome ou loja" Target="{Binding ElementName=Search}" Style="{DynamicResource FieldLabel}"/>
            <TextBox x:Name="Search" Style="{DynamicResource Input}" AutomationProperties.Name="Buscar por nome ou loja"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#151C20" BorderBrush="#293638" BorderThickness="1" CornerRadius="10" Padding="5">
            <Grid>
                <ListBox x:Name="Results" Background="Transparent" Foreground="#EDF2F0" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Jogos detectados">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="Transparent"
                                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Margin="0,0,0,2">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#222C30"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#24382E"/>
                                                <Setter TargetName="Row" Property="BorderBrush" Value="#3A5745"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Row" Property="BorderBrush" Value="#BAF48B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="8" Background="#233032" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE7FC;" Style="{DynamicResource Glyph}" Foreground="#BACECA" FontSize="15"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Target}" ToolTip="{Binding Target}" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" Foreground="#A6B6B4" FontSize="11"/>
                                </StackPanel>
                                <Border Grid.Column="2" VerticalAlignment="Center" Background="#263533"
                                        CornerRadius="5" Padding="7,4" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Store}" Foreground="#D1E0DB" FontSize="11"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="EmptyResults" Visibility="Collapsed" IsHitTestVisible="False"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                    <TextBlock Text="Nenhum jogo corresponde à busca" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock Text="Tente outro nome ou loja." Foreground="#A6B6B4" FontSize="12" Margin="0,5,0,0" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <Button x:Name="SelectGame" DockPanel.Dock="Right" Content="Selecionar jogo" IsDefault="True" IsEnabled="False"
                    Style="{DynamicResource Primary}" MinWidth="129"/>
            <Button DockPanel.Dock="Right" Content="Fechar" IsCancel="True" Margin="0,0,8,0" Style="{DynamicResource Quiet}"/>
            <TextBlock x:Name="Count" Foreground="#A6B6B4" FontSize="12" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
    </Border>
</Window>
