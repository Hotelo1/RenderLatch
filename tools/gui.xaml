<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RenderLatch" Width="1220" Height="820" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#0D1114"
        Foreground="#EDF2F0" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#151C20"/>
        <SolidColorBrush x:Key="Recess" Color="#0F1518"/>
        <SolidColorBrush x:Key="Edge" Color="#293638"/>
        <SolidColorBrush x:Key="WindowText" Color="#EDF2F0"/>
        <SolidColorBrush x:Key="Muted" Color="#A6B6B4"/>
        <SolidColorBrush x:Key="Accent" Color="#BAF48B"/>
        <SolidColorBrush x:Key="Warning" Color="#F3CA89"/>
        <SolidColorBrush x:Key="Failure" Color="#FFAAA3"/>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="ToolIcon" TargetType="Border">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="#22362F"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="ToolIconGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="17"/>
        </Style>
        <Style x:Key="ToolRowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#232C30"/>
            <Setter Property="Foreground" Value="#F2F5F4"/>
            <Setter Property="BorderBrush" Value="#3A484D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" CornerRadius="7" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#9DBC8B"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Background" Value="#20292C"/>
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#323E42"/>
                                <Setter Property="Foreground" Value="#82908F"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#182611"/>
        </Style>
        <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Recess}"/>
            <Setter Property="Foreground" Value="#EDF2F0"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="#3A484A"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputFrame" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EDF2F0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Option" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Option" Property="Background" Value="#24372C"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Option" Property="Background" Value="#293D36"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#EDF2F0"/>
            <Setter Property="Background" Value="{StaticResource Recess}"/>
            <Setter Property="BorderBrush" Value="#3A484A"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="MaxDropDownHeight" Value="300"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropToggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="DropFrame" Background="{StaticResource Recess}" BorderBrush="#3A484A" BorderThickness="1" CornerRadius="8">
                                            <Path Data="M0,0 L4,4 8,0" Stroke="{StaticResource Muted}" StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Margin="0,0,13,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="DropFrame" Property="BorderBrush" Value="#82A293"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="DropFrame" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="ComboFocus" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="8"
                                    Visibility="Hidden" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="11,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=DropToggle}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, ElementName=DropToggle}" Margin="0,4,0,0" Background="#1C2629"
                                        BorderBrush="#3A4C4A" BorderThickness="1" CornerRadius="9" Padding="4">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ComboFocus" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#DCE6E2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ExpanderFrame" Background="Transparent" CornerRadius="6" Padding="1,7">
                                            <DockPanel>
                                                <Path x:Name="Chevron" DockPanel.Dock="Right" Data="M0,0 L4,4 8,0" Stroke="{StaticResource Muted}"
                                                      StrokeThickness="1.4" VerticalAlignment="Center" Margin="8,0"/>
                                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Data" Value="M0,4 L4,0 8,4"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="ExpanderFrame" Property="Background" Value="#293D36"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpanderContent" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F2F5F4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="CheckFrame" Width="17" Height="17" Margin="0,0,7,0" CornerRadius="4"
                                    Background="#101719" BorderThickness="1" BorderBrush="#60716F" VerticalAlignment="Center">
                                <TextBlock x:Name="CheckMark" Visibility="Collapsed" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                           Foreground="#182611" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckFrame" Property="Background" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CheckFrame" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Navigation" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavFrame" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="8" Padding="11,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavFrame" Property="Background" Value="#222C2E"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavFrame" Property="Background" Value="#24382E"/>
                                <Setter TargetName="NavFrame" Property="BorderBrush" Value="#365340"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NavFrame" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="#13191C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Padding="2,0" Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="22">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#536463" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#0D1114">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="188"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#12181B" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,1,0" Padding="15,24,15,18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,35">
                    <Border Width="38" Height="38" Margin="0,0,10,0">
                        <Image x:Name="AppLogo" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="RenderLatch" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="AppUpdate" DockPanel.Dock="Bottom" Visibility="Collapsed">
                    <TextBlock x:Name="AppUpdateStatus" Style="{StaticResource Caption}" FontSize="12"
                               Visibility="Collapsed" Margin="0,0,0,7" AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="AppUpdateButton" MinHeight="38" Padding="8,5" Background="#1A2226"
                            ToolTip="Verificar atualizações do RenderLatch" AutomationProperties.Name="Verificar atualizações do RenderLatch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="UpdateFrame" Background="{TemplateBinding Background}" CornerRadius="7"
                                        Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="#29373A">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="UpdateFrame" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="UpdateFrame" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="UpdateFrame" Property="Opacity" Value="0.78"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="UpdateFrame" Property="Opacity" Value="0.56"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="AppVersion" DockPanel.Dock="Right" FontSize="10" FontWeight="Normal"
                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock x:Name="AppUpdateLabel" Text="Atualizações" FontSize="12" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <RadioButton x:Name="NavGames" Style="{StaticResource Navigation}" GroupName="Page" IsChecked="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7FC;" Width="25" VerticalAlignment="Center"/>
                            <TextBlock Text="Jogos" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavPc" Style="{StaticResource Navigation}" GroupName="Page">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE95E;" Width="25" VerticalAlignment="Center"/>
                            <TextBlock Text="Diagnóstico" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavTools" Style="{StaticResource Navigation}" GroupName="Page">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Width="25" VerticalAlignment="Center"/>
                            <TextBlock Text="Ferramentas" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="24,24,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62*" MinWidth="400"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="38*" MinWidth="266"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="WorkScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <StackPanel x:Name="GamePage">
                            <StackPanel x:Name="LibraryView">
                                <DockPanel Margin="0,0,0,6" LastChildFill="True">
                                    <Button x:Name="FindGames" DockPanel.Dock="Right" Content="Atualizar lista"
                                            VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBlock Text="Biblioteca de jogos" Style="{StaticResource PageTitle}" TextWrapping="Wrap"/>
                                </DockPanel>
                                <TextBlock Text="Escolha um jogo para configurar o DLSS e o Frame Generation."
                                           Style="{StaticResource Caption}" FontSize="14" Margin="0,0,0,18"/>
                                <DockPanel Margin="0,0,0,16" LastChildFill="True">
                                    <Button x:Name="ManualGame" DockPanel.Dock="Right" Content="Selecionar manualmente"
                                            Margin="10,0,0,0"/>
                                    <Grid>
                                        <TextBox x:Name="LibrarySearch" Style="{StaticResource Input}" MinHeight="44" FontSize="14"
                                                 Padding="40,6,14,6" AutomationProperties.Name="Buscar por jogo ou loja"/>
                                        <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" Foreground="{StaticResource Muted}"
                                                   FontSize="15" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False"/>
                                        <TextBlock Text="Buscar por jogo ou loja" Foreground="{StaticResource Muted}" Margin="43,0,14,0"
                                                   FontSize="{Binding FontSize, ElementName=LibrarySearch}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=LibrarySearch}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DockPanel>
                                <TextBlock x:Name="LibraryStatus" Style="{StaticResource Caption}" Margin="0,0,0,12"
                                           AutomationProperties.LiveSetting="Polite"/>
                                <ItemsControl x:Name="LibraryTiles" AutomationProperties.Name="Jogos instalados">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding}" ToolTip="{Binding Folder}" MinHeight="0"
                                                    AutomationProperties.Name="{Binding Name}" Width="156" Margin="0,0,12,12"
                                                    Padding="0" HorizontalContentAlignment="Stretch">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Tile" CornerRadius="11" Background="#151C20"
                                                                BorderBrush="{StaticResource Edge}" BorderThickness="1">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="Tile" Property="Background" Value="#24352C"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <StackPanel>
                                                    <Grid Height="216" Margin="5,5,5,0" ClipToBounds="True">
                                                        <Border CornerRadius="7">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#28463C" Offset="0"/>
                                                                    <GradientStop Color="#22323D" Offset="0.55"/>
                                                                    <GradientStop Color="#172024" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7FC;"
                                                                   Foreground="{StaticResource Accent}" FontSize="30"/>
                                                        <Image Source="{Binding Icon}" Width="54" Height="54"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image Source="{Binding Artwork}" Stretch="UniformToFill" SnapsToDevicePixels="True"/>
                                                    </Grid>
                                                    <StackPanel Margin="10,8,10,9">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" Height="34" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Store}" Foreground="{StaticResource Muted}"
                                                                   FontSize="11" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel x:Name="GameDetails" Visibility="Collapsed">
                            <Button x:Name="BackToLibrary" Content="‹  Voltar à biblioteca" Style="{StaticResource Quiet}"
                                    HorizontalAlignment="Left" Margin="0,0,0,12"/>
                            <Border Style="{StaticResource Card}" BorderBrush="#35473E">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#22332C" Offset="0"/>
                                        <GradientStop Color="#192628" Offset="0.65"/>
                                        <GradientStop Color="#151C20" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="54" Height="64" CornerRadius="8" Background="#2C4235" Margin="0,0,12,0">
                                            <Grid ClipToBounds="True">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7FC;" Foreground="{StaticResource Accent}" FontSize="22"/>
                                                <Image x:Name="SelectedGameCover" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock x:Name="GameSelection" Style="{StaticResource SectionTitle}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            <TextBlock x:Name="SelectionHint" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border BorderBrush="#364740" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,5,0,0">
                                        <Expander x:Name="ManualTarget" Header="Selecionar manualmente">
                                            <StackPanel Margin="0,6,0,2">
                                                <Label Content="_Pasta ou executável" Target="{Binding ElementName=GamePath}" Style="{StaticResource FieldLabel}"/>
                                                <DockPanel>
                                                    <Button x:Name="BrowseExe" DockPanel.Dock="Right" Content=".exe…" Margin="6,0,0,0"
                                                            ToolTip="Selecionar o executável do jogo"/>
                                                    <Button x:Name="Browse" DockPanel.Dock="Right" Content="Pasta…" Margin="6,0,0,0"/>
                                                    <TextBox x:Name="GamePath" Style="{StaticResource Input}"
                                                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Expander>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Configuração gráfica" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="RouteSummary" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    <TextBlock x:Name="OptiOptionsHint" Style="{StaticResource Caption}" Margin="0,7,0,0"/>
                                    <CheckBox x:Name="OpticalF5" Content="Usar Optical F5Low" IsChecked="True" Margin="0,12,0,4"/>
                                    <StackPanel x:Name="OpticalOptions" Margin="0,4,0,4">
                                        <Label Content="Gerador de quadros" Target="{Binding ElementName=OpticalGenerator}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="OpticalGenerator" SelectedIndex="0">
                                            <ComboBoxItem Content="Automático para a GPU" Tag="auto"/>
                                            <ComboBoxItem Content="NVIDIA DLSS Frame Generation" Tag="dlss"/>
                                            <ComboBoxItem Content="AMD FSR Frame Generation" Tag="fsr"/>
                                            <ComboBoxItem Content="Intel Xe Frame Generation" Tag="xess"/>
                                            <ComboBoxItem Content="F5Low XeFG Tensor (NVIDIA)" Tag="tensor"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <CheckBox x:Name="UseInGameMenu" Content="Adicionar menu OptiScaler ao Feeder"
                                              Visibility="Collapsed" Margin="0,12,0,0"/>
                                    <StackPanel x:Name="OptiOptions" Visibility="Collapsed" Margin="0,14,0,0">
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,6,0">
                                                <Label Target="{Binding ElementName=Upscaler}" Content="_Upscaling" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="Upscaler" SelectedIndex="0" AutomationProperties.Name="Upscaling">
                                                    <ComboBoxItem Content="Manter atual" Tag=""/>
                                                    <ComboBoxItem Content="Automático" Tag="auto"/>
                                                    <ComboBoxItem Content="NVIDIA DLSS" Tag="dlss"/>
                                                    <ComboBoxItem Content="AMD FSR 3.1" Tag="fsr3"/>
                                                    <ComboBoxItem Content="AMD FSR 4.0.2" Tag="fsr4"/>
                                                    <ComboBoxItem Content="Intel XeSS" Tag="xess"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Margin="6,0,0,0">
                                                <Label Target="{Binding ElementName=FrameGen}" Content="_Frame Generation" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="FrameGen" SelectedIndex="0" AutomationProperties.Name="Frame Generation" ToolTip="Escolhe o perfil. Ative o Frame Generation pelo menu do OptiScaler no jogo.">
                                                    <ComboBoxItem Content="Manter atual" Tag=""/>
                                                    <ComboBoxItem Content="Desativado" Tag="off"/>
                                                    <ComboBoxItem Content="NVIDIA DLSS FG" Tag="dlss"/>
                                                    <ComboBoxItem Content="AMD FSR 3.1 FG" Tag="fsr3"/>
                                                    <ComboBoxItem Content="AMD FSR 4.0 FG" Tag="fsr4"/>
                                                    <ComboBoxItem Content="Intel XeSS FG" Tag="xess"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </UniformGrid>
                                        <StackPanel x:Name="FrameGenSource" Visibility="Collapsed" Margin="0,11,0,0">
                                            <Label Target="{Binding ElementName=FrameGenInput}" Content="_Origem dos dados do Frame Generation"
                                                   Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="FrameGenInput" SelectedIndex="0" AutomationProperties.Name="Origem dos dados do Frame Generation">
                                                <ComboBoxItem Content="Detectar automaticamente" Tag="auto"/>
                                                <ComboBoxItem Content="Upscaler (OptiFG)" Tag="upscaler"/>
                                                <ComboBoxItem Content="DLSS FG nativo (Streamline)" Tag="dlssg"/>
                                                <ComboBoxItem Content="FSR 3.1 FG nativo" Tag="fsrfg"/>
                                                <ComboBoxItem Content="FSR 3.0 FG nativo" Tag="fsrfg30"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                    <Expander Header="Opções avançadas" Margin="0,11,0,-5">
                                        <CheckBox x:Name="UseFeeder" Content="Forçar rota Feeder" Margin="0,6,0,5"
                                                  ToolTip="Usar o Feeder mesmo quando o Forge detectar DLLs de DLSS."/>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,5">
                                <StackPanel>
                                    <DockPanel>
                                        <Button x:Name="Optimize" DockPanel.Dock="Right" Content="Otimizar para este PC"
                                                VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Desempenho" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="Ajuste o perfil instalado para este PC."
                                                       Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Expander Header="Manutenção" Margin="0,9,0,-6">
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button x:Name="RestoreResolution" Content="Restaurar resolução" Style="{StaticResource Quiet}"
                                                    Margin="0,0,5,5" ToolTip="Desfaz o ajuste de resolução em jogos Unity com Feeder DX12."/>
                                            <Button x:Name="Inventory" Content="Listar DLLs" Style="{StaticResource Quiet}" Margin="0,0,5,5"/>
                                            <Button x:Name="Undo" Content="Desfazer instalação" Style="{StaticResource Quiet}" Margin="0,0,0,5"/>
                                        </WrapPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="PcPage" Visibility="Collapsed">
                            <TextBlock Text="Diagnóstico do PC" Style="{StaticResource PageTitle}" Margin="0,0,0,18"/>
                            <Border Style="{StaticResource Card}" BorderBrush="#355044">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#20332C" Offset="0"/>
                                        <GradientStop Color="#171F22" Offset="0.86"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Left" Style="{StaticResource ToolIcon}">
                                            <TextBlock Style="{StaticResource ToolIconGlyph}" Text="&#xE7F4;"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="Hardware" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="CPU, GPU, memória, VRAM e conexão PCIe."
                                                       Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Button x:Name="Detect" Content="Detectar hardware" HorizontalAlignment="Left"
                                            Style="{StaticResource Primary}" Margin="0,15,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Análise do sistema" Style="{StaticResource SectionTitle}" Margin="0,0,0,13"/>
                                    <DockPanel LastChildFill="True">
                                        <Button x:Name="Plan" DockPanel.Dock="Right" Content="Ver plano" Width="116" Margin="12,0,0,0"
                                                VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Plano de desempenho" Style="{StaticResource ToolRowTitle}"/>
                                            <TextBlock Text="Ajustes sugeridos para o seu hardware." Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Border BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Margin="0,13,0,0" Padding="0,13,0,0">
                                        <DockPanel LastChildFill="True">
                                            <Button x:Name="Doctor" DockPanel.Dock="Right" Content="Ver pendências" Width="116" Margin="12,0,0,0"
                                                    VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Compatibilidade" Style="{StaticResource ToolRowTitle}"/>
                                                <TextBlock Text="Verifique requisitos e pendências do PC." Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="ToolsPage" Visibility="Collapsed">
                            <TextBlock Text="Ferramentas" Style="{StaticResource PageTitle}" Margin="0,0,0,18"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Left" Style="{StaticResource ToolIcon}">
                                            <TextBlock Style="{StaticResource ToolIconGlyph}" Text="&#xE896;"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="Kit de gráficos" Style="{StaticResource SectionTitle}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Ellipse Width="6" Height="6" Margin="0,0,6,0"
                                                         Fill="{Binding Foreground, ElementName=KitStatus}"/>
                                                <TextBlock x:Name="KitStatus" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="OptiScaler, Streamline, modelo NVIDIA e DLSS5oneclick. O primeiro download pode chegar a 700 MB."
                                               Style="{StaticResource Caption}" Margin="0,12,0,13"/>
                                    <Button x:Name="Download" Content="Baixar kit completo" Style="{StaticResource Primary}"
                                            HorizontalAlignment="Left"/>
                                    <Border BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Margin="0,15,0,0" Padding="0,12,0,0">
                                        <DockPanel LastChildFill="True">
                                            <Button x:Name="ImportModel" DockPanel.Dock="Right" Content="Importar modelo…"
                                                    Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Modelo NVIDIA local" Style="{StaticResource ToolRowTitle}"/>
                                                <TextBlock Text="Use uma cópia já baixada." Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Left" Style="{StaticResource ToolIcon}">
                                            <TextBlock Style="{StaticResource ToolIconGlyph}" Text="&#xE713;"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="DLSS5oneclick" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock x:Name="OneClickStatus" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <WrapPanel Margin="0,13,0,-4">
                                        <Button x:Name="ChooseOneClick" Content="Usar outro executável…" Margin="0,0,7,4"/>
                                        <Button x:Name="OneClickReleases" Content="Releases no GitHub" Style="{StaticResource Quiet}" Margin="0,0,0,4"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border x:Name="DeveloperTools" Style="{StaticResource Card}">
                                <Expander Header="Ferramentas de desenvolvimento">
                                    <WrapPanel Margin="0,9,0,0">
                                        <Button x:Name="Build" Content="Recompilar Forge" Margin="0,0,8,0"/>
                                        <Button x:Name="Menu" Content="Abrir menu CLI"/>
                                    </WrapPanel>
                                </Expander>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Border x:Name="ActivityPane" Grid.Column="2" Style="{StaticResource Card}" Padding="12" Margin="0" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="2,0,0,11">
                            <Button x:Name="ClearLog" DockPanel.Dock="Right" Content="Limpar" MinHeight="32" Padding="7,4" Style="{StaticResource Quiet}"/>
                            <Button x:Name="CopyLog" DockPanel.Dock="Right" Content="Copiar" MinHeight="32" Padding="7,4" Style="{StaticResource Quiet}"/>
                            <Button x:Name="ExpandLog" DockPanel.Dock="Right" Content="Ampliar" MinHeight="32" Padding="7,4" Style="{StaticResource Quiet}"/>
                            <TextBlock Text="Atividade" Style="{StaticResource SectionTitle}" FontSize="17" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border x:Name="OperationCard" Grid.Row="1" CornerRadius="9" Background="#1C2628"
                                BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="11,9"
                                HorizontalAlignment="Stretch" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="OperationTitle" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                <TextBlock x:Name="OperationResult" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Margin="0,11,0,0" CornerRadius="9" Background="{StaticResource Recess}"
                                BorderBrush="{StaticResource Edge}" BorderThickness="1">
                            <Grid>
                                <TextBox x:Name="Activity" Padding="11" Background="Transparent" Foreground="#DEE8E4" BorderThickness="0"
                                         FontFamily="Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Saída das operações"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="240" Margin="14"
                                            IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=Activity}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE9F9;" Foreground="{StaticResource Muted}" FontSize="23" Margin="0,0,0,12"/>
                                    <TextBlock Text="Nenhuma atividade" FontWeight="SemiBold" TextAlignment="Center"/>
                                    <TextBlock Text="As prévias e as operações do Forge aparecem aqui." Style="{StaticResource Caption}"
                                               FontSize="12" TextAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="InstallBar" Grid.Row="1" Visibility="Collapsed" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0"
                    Padding="24,13" Background="#161F22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="InstallTitle" FontWeight="SemiBold"/>
                        <TextBlock x:Name="GameHint" Style="{StaticResource Caption}" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="Preview" Content="Ver prévia" MinWidth="102" Margin="0,0,8,0"/>
                        <Button x:Name="Apply" Content="Aplicar instalação" Style="{StaticResource Primary}" MinWidth="143"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Padding="24,8" Background="#11181B">
                <DockPanel>
                    <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Visibility="Hidden" Width="96" Height="4"
                                 Foreground="{StaticResource Accent}" Background="#2C363A" BorderThickness="0"/>
                    <TextBlock x:Name="Status" Style="{StaticResource Caption}" FontSize="12" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
